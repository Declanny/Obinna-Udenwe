# Copy this file to .env and fill in the values

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-python-secrets

# Generate with: uv run python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('obinna2026'))"
ADMIN_PASSWORD_HASH=

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=admin-destination@example.com
# Optional: defaults to onboarding@resend.dev (works for testing)
# For production, verify your domain in Resend and set this:
# RESEND_FROM_EMAIL=Your Name <you@yourdomain.com>

# Database — SQLiteCloud for production, local SQLite for dev
# DATABASE_URL=sqlitecloud://<host>:<port>/<db>?apikey=<key>
# DATABASE_URL=sqlite:///./admin.db   ← local dev fallback

# Test/dev login bypass — skips OTP entirely; REMOVE BEFORE PRODUCTION
# TEST_ADMIN_USERNAME=testadmin
# TEST_ADMIN_PASSWORD=testpassword123

# Optional overrides (defaults shown)
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# ADMIN_USERNAME=admin
# CLOUDINARY_FOLDER=obinna-udenwe
